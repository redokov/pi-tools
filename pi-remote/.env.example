# pi-remote environment file. Copy to .env next to server.js and edit.
# Lines: KEY=VALUE, '#' comments, values trimmed. Real environment variables
# override the values in this file. Values are never logged by the server.

# REQUIRED: admin password for the web UI. Without it the server refuses to start.
# Generate one, e.g.: node -e "console.log(require('crypto').randomBytes(9).toString('hex'))"
PI_REMOTE_PASSWORD=change-me

# OPTIONAL: session lifetime in hours (sliding TTL: refreshed on every visit).
# Default: 720 (30 days). Restarting the server invalidates all sessions.
# PI_REMOTE_SESSION_TTL_HOURS=720

# OPTIONAL: token for the machine-to-machine /api/notify endpoint
# (sent by pi-billing-window as the X-Notify-Token header; no cookie involved).
# PI_REMOTE_NOTIFY_TOKEN=
