#Область ПрограммныйИнтерфейс

// Проверяет доступность Java пользователю, под которым выполняется код.
// Данные операционной системы собираются самостоятельно (серверный контекст).
//
// Возвращаемое значение:
//  Структура - результаты проверки:
//   * Доступна - Булево - Истина, если Java доступна;
//   * Версия - Строка - версия Java;
//   * ПутьКJava - Строка - путь к исполняемому файлу java.exe;
//   * Пользователь - Строка - имя пользователя операционной системы;
//   * Детали - Строка - подробности выполнения проверки.
//
Функция ПроверитьДоступностьДжавы() Экспорт

	Возврат ПроанализироватьДанные(СобратьДанныеПроверки());

КонецФункции

// Анализирует переданные данные операционной системы без обращения к ней.
// Предназначена для тестирования и повторного анализа.
//
// Параметры:
//  Пользователь - Строка - имя пользователя операционной системы;
//  ЗначениеJavaHome - Строка - значение переменной среды JAVA_HOME;
//  ЗначениеPath - Строка - значение переменной среды PATH;
//  КодВозвратаJavaVersion - Число - код возврата команды java -version;
//  ТекстВерсииJava - Строка - вывод команды java -version.
//
// Возвращаемое значение:
//  Структура - результаты проверки (см. ПроверитьДоступностьДжавы).
//
Функция ПроверитьПоДанным(Пользователь, ЗначениеJavaHome, ЗначениеPath,
	КодВозвратаJavaVersion, ТекстВерсииJava) Экспорт

	Данные = Новый Структура;
	Данные.Вставить("Пользователь", Пользователь);
	Данные.Вставить("ЗначениеJavaHome", ЗначениеJavaHome);
	Данные.Вставить("ЗначениеPath", ЗначениеPath);
	Данные.Вставить("КодВозвратаJavaVersion", КодВозвратаJavaVersion);
	Данные.Вставить("ТекстВерсииJava", ТекстВерсииJava);

	Возврат ПроанализироватьДанные(Данные);

КонецФункции

// Собирает данные о доступности Java командами операционной системы.
// Выполняется в контексте пользователя, под которым работает процесс,
// вызвавший метод (для серверного вызова - учётная запись службы сервера 1С).
//
// Возвращаемое значение:
//  Структура, Неопределено - собранные данные либо Неопределено, если операционная
//                            система недоступна (например, безопасный режим).
//
Функция СобратьДанныеПроверки() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Пользователь", "");
	Результат.Вставить("ЗначениеJavaHome", "");
	Результат.Вставить("ЗначениеPath", "");
	Результат.Вставить("КодВозвратаJavaVersion", -1);
	Результат.Вставить("ТекстВерсииJava", "");
	Результат.Вставить("ОшибкаСбора", "");

	Попытка
		Результат.Пользователь = СокрЛП(ВыполнитьКомандуОС("whoami").ТекстВывода);
		Результат.ЗначениеJavaHome = СокрЛП(ВыполнитьКомандуОС("echo %JAVA_HOME%").ТекстВывода);
		Результат.ЗначениеPath = ВыполнитьКомандуОС("set PATH").ТекстВывода;

		ВыводВерсии = ВыполнитьКомандуОС("java -version");
		Результат.КодВозвратаJavaVersion = ВыводВерсии.КодВозврата;
		Результат.ТекстВерсииJava = ВыводВерсии.ТекстВывода;
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		Результат.ОшибкаСбора = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
	КонецПопытки;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Анализирует данные операционной системы и формирует результат проверки.
//
// Параметры:
//  Данные - Структура, Неопределено - данные проверки либо Неопределено,
//           если их не удалось собрать.
//
// Возвращаемое значение:
//  Структура - результаты проверки.
//
Функция ПроанализироватьДанные(Данные)

	Результат = Новый Структура;
	Результат.Вставить("Доступна", Ложь);
	Результат.Вставить("Версия", "");
	Результат.Вставить("ПутьКJava", "");
	Результат.Вставить("Пользователь", СтроковоеЗначение(Данные, "Пользователь"));
	Результат.Вставить("Детали", "");

	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Результат.Детали = "Не удалось собрать данные операционной системы";
		Возврат Результат;
	КонецЕсли;

	ЗначениеJavaHome = СтроковоеЗначение(Данные, "ЗначениеJavaHome");
	ЗначениеPath = СтроковоеЗначение(Данные, "ЗначениеPath");
	ТекстВывода = СтроковоеЗначение(Данные, "ТекстВерсииJava");
	КодВозврата = ЧисловоеЗначение(Данные, "КодВозвратаJavaVersion", -1);

	КаталогJavaHome = КаталогИзJavaHome(ЗначениеJavaHome);
	ПутьВJavaHome = ПутьКJavaВКаталоге(КаталогJavaHome);
	ПоискВPath = НайтиJavaВPath(ЗначениеPath);

	Результат.Версия = ВерсияИзВыводаJava(ТекстВывода);
	Результат.ПутьКJava = ?(ЗначениеЗаполнено(ПутьВJavaHome), ПутьВJavaHome, ПоискВPath.Путь);
	Результат.Доступна = (КодВозврата = 0) И (СтрНайти(ВРег(ТекстВывода), "VERSION") > 0);
	Результат.Детали = ТекстДеталей(Результат.Пользователь, КаталогJavaHome, ПутьВJavaHome,
		ПоискВPath, КодВозврата, ТекстВывода);

	ОшибкаСбора = СтроковоеЗначение(Данные, "ОшибкаСбора");
	Если ЗначениеЗаполнено(ОшибкаСбора) Тогда
		Результат.Доступна = Ложь;
		Результат.Детали = "Не удалось выполнить команды операционной системы: " + ОшибкаСбора;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Выполняет команду операционной системы и возвращает её вывод.
//
// Параметры:
//  Команда - Строка - команда, передаваемая интерпретатору cmd.
//
// Возвращаемое значение:
//  Структура - результат выполнения:
//   * ТекстВывода - Строка - объединённый стандартный вывод и вывод ошибок;
//   * КодВозврата - Число - код возврата команды, -1 при ошибке выполнения.
//
Функция ВыполнитьКомандуОС(Команда)

	Результат = Новый Структура;
	Результат.Вставить("ТекстВывода", "");
	Результат.Вставить("КодВозврата", -1);

	ИмяФайлаВывода = ПолучитьИмяВременногоФайла("txt");

	Попытка
		КодВозврата = 0;
		СтрокаЗапуска = СтрШаблон("cmd /c %1 > ""%2"" 2>&1", Команда, ИмяФайлаВывода);
		ЗапуститьПриложение(СтрокаЗапуска, , Истина, КодВозврата);
		Результат.КодВозврата = КодВозврата;

		ФайлВывода = Новый Файл(ИмяФайлаВывода);
		Если ФайлВывода.Существует() Тогда
			Результат.ТекстВывода = ПрочитатьТекстФайла(ИмяФайлаВывода);
			УдалитьФайлы(ИмяФайлаВывода);
		КонецЕсли;
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		Результат.КодВозврата = -1;
		Результат.ТекстВывода = "Ошибка выполнения команды """ + Команда + """: "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Читает текстовый файл с выводом консольной команды.
//
// Параметры:
//  ИмяФайла - Строка - полный путь к файлу.
//
// Возвращаемое значение:
//  Строка - содержимое файла.
//
Функция ПрочитатьТекстФайла(ИмяФайла)

	Текст = "";
	КодировкиДляЧтения = Новый Массив;
	КодировкиДляЧтения.Добавить("cp866");
	КодировкиДляЧтения.Добавить("windows-1251");
	КодировкиДляЧтения.Добавить("UTF-8");

	Для Каждого ИмяКодировки Из КодировкиДляЧтения Цикл
		Попытка
			ЧтениеТекста = Новый ЧтениеТекста(ИмяФайла, ИмяКодировки);
			Текст = ЧтениеТекста.Прочитать();
			ЧтениеТекста.Закрыть();
			Прервать;
		Исключение
			Текст = "";
		КонецПопытки;
	КонецЦикла;

	Возврат Текст;

КонецФункции

// Возвращает текстовое значение поля структуры.
//
// Параметры:
//  Данные - Структура - структура с данными проверки;
//  ИмяПоля - Строка - имя поля.
//
// Возвращаемое значение:
//  Строка - значение поля или пустая строка.
//
Функция СтроковоеЗначение(Данные, ИмяПоля)

	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;

	Значение = Неопределено;
	Если Данные.Свойство(ИмяПоля, Значение) И ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат СокрЛП(Значение);
	КонецЕсли;

	Возврат "";

КонецФункции

// Возвращает числовое значение поля структуры.
//
// Параметры:
//  Данные - Структура - структура с данными проверки;
//  ИмяПоля - Строка - имя поля;
//  ЗначениеПоУмолчанию - Число - значение, возвращаемое при отсутствии поля.
//
// Возвращаемое значение:
//  Число - значение поля или значение по умолчанию.
//
Функция ЧисловоеЗначение(Данные, ИмяПоля, ЗначениеПоУмолчанию)

	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Значение = Неопределено;
	Если Данные.Свойство(ИмяПоля, Значение) И ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

// Выделяет каталог Java из значения переменной среды JAVA_HOME.
//
// Параметры:
//  ЗначениеJavaHome - Строка - вывод команды, выводящей значение JAVA_HOME.
//
// Возвращаемое значение:
//  Строка - каталог Java или пустая строка, если переменная не задана.
//
Функция КаталогИзJavaHome(ЗначениеJavaHome)

	Каталог = СокрЛП(ЗначениеJavaHome);

	Пока Каталог <> "" И (Прав(Каталог, 1) = """" Или Прав(Каталог, 1) = "\") Цикл
		Каталог = СокрЛП(Лев(Каталог, СтрДлина(Каталог) - 1));
	КонецЦикла;

	Пока Каталог <> "" И Лев(Каталог, 1) = """" Цикл
		Каталог = СокрЛП(Сред(Каталог, 2));
	КонецЦикла;

	Если СтрНайти(Каталог, "%") > 0 Или ВРег(Лев(Каталог, 4)) = "ECHO" Тогда
		Возврат "";
	КонецЕсли;

	Возврат Каталог;

КонецФункции

// Возвращает путь к java.exe в подкаталоге bin указанного каталога.
//
// Параметры:
//  КаталогJava - Строка - каталог установки Java.
//
// Возвращаемое значение:
//  Строка - полный путь к java.exe или пустая строка.
//
Функция ПутьКJavaВКаталоге(КаталогJava)

	Если Не ЗначениеЗаполнено(КаталогJava) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		ФайлJava = Новый Файл(КаталогJava + "\bin\java.exe");
		Если ФайлJava.Существует() Тогда
			Возврат ФайлJava.ПолноеИмя;
		КонецЕсли;
	Исключение
		Возврат "";
	КонецПопытки;

	Возврат "";

КонецФункции

// Ищет java.exe в каталогах переменной среды PATH.
//
// Параметры:
//  ЗначениеPath - Строка - вывод команды, выводящей значение PATH.
//
// Возвращаемое значение:
//  Структура - результат поиска:
//   * Путь - Строка - полный путь к java.exe или пустая строка;
//   * ПровереноКаталогов - Число - количество проверенных каталогов.
//
Функция НайтиJavaВPath(ЗначениеPath)

	Результат = Новый Структура;
	Результат.Вставить("Путь", "");
	Результат.Вставить("ПровереноКаталогов", 0);

	ЗначениеПеременной = "";
	Для Каждого СтрокаВывода Из СтрокиТекста(ЗначениеPath) Цикл
		ПозицияРавно = СтрНайти(СтрокаВывода, "=");
		Если ПозицияРавно > 0 И ВРег(СокрЛП(Лев(СтрокаВывода, ПозицияРавно - 1))) = "PATH" Тогда
			ЗначениеПеременной = Сред(СтрокаВывода, ПозицияРавно + 1);
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Не ЗначениеЗаполнено(ЗначениеПеременной) Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого ЭлементPath Из СтрРазделить(ЗначениеПеременной, ";") Цикл
		Каталог = НормализоватьКаталог(ЭлементPath);
		Если Не ЗначениеЗаполнено(Каталог) Тогда
			Продолжить;
		КонецЕсли;

		Результат.ПровереноКаталогов = Результат.ПровереноКаталогов + 1;

		Попытка
			ФайлJava = Новый Файл(Каталог + "\java.exe");
			Если ФайлJava.Существует() Тогда
				Результат.Путь = ФайлJava.ПолноеИмя;
				Прервать;
			КонецЕсли;
		Исключение
			Продолжить;
		КонецПопытки;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Убирает кавычки и завершающий разделитель каталога.
//
// Параметры:
//  Значение - Строка - элемент списка каталогов.
//
// Возвращаемое значение:
//  Строка - нормализованный путь к каталогу.
//
Функция НормализоватьКаталог(Значение)

	Каталог = СокрЛП(Значение);

	Пока Каталог <> "" И (Лев(Каталог, 1) = """" Или Прав(Каталог, 1) = """") Цикл
		Если Лев(Каталог, 1) = """" Тогда
			Каталог = СокрЛП(Сред(Каталог, 2));
		Иначе
			Каталог = СокрЛП(Лев(Каталог, СтрДлина(Каталог) - 1));
		КонецЕсли;
	КонецЦикла;

	Пока Прав(Каталог, 1) = "\" Цикл
		Каталог = СокрЛП(Лев(Каталог, СтрДлина(Каталог) - 1));
	КонецЦикла;

	Возврат Каталог;

КонецФункции

// Разбивает текст на строки.
//
// Параметры:
//  Текст - Строка - исходный текст.
//
// Возвращаемое значение:
//  Массив - строки текста.
//
Функция СтрокиТекста(Текст)

	НормализованныйТекст = СтрЗаменить(Текст, Символы.ВК, "");
	Если Не ЗначениеЗаполнено(НормализованныйТекст) Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Возврат СтрРазделить(НормализованныйТекст, Символы.ПС);

КонецФункции

// Извлекает версию Java из вывода команды java -version.
//
// Параметры:
//  ТекстВывода - Строка - вывод команды java -version.
//
// Возвращаемое значение:
//  Строка - версия Java или пустая строка.
//
Функция ВерсияИзВыводаJava(ТекстВывода)

	Для Каждого СтрокаВывода Из СтрокиТекста(ТекстВывода) Цикл
		Позиция = СтрНайти(ВРег(СтрокаВывода), "VERSION");
		Если Позиция = 0 Тогда
			Продолжить;
		КонецЕсли;

		Версия = СокрЛП(Сред(СтрокаВывода, Позиция + СтрДлина("version")));
		Возврат СокрЛП(СтрЗаменить(Версия, """", ""));
	КонецЦикла;

	Возврат "";

КонецФункции

// Формирует текст деталей проверки.
//
// Параметры:
//  ПользовательОС - Строка - имя пользователя операционной системы;
//  КаталогJavaHome - Строка - каталог из переменной JAVA_HOME;
//  ПутьВJavaHome - Строка - путь к java.exe в каталоге JAVA_HOME;
//  ПоискВPath - Структура - результат поиска java.exe в PATH;
//  КодВозврата - Число - код возврата команды java -version;
//  ТекстВывода - Строка - вывод команды java -version.
//
// Возвращаемое значение:
//  Строка - описание выполненной проверки.
//
Функция ТекстДеталей(ПользовательОС, КаталогJavaHome, ПутьВJavaHome, ПоискВPath, КодВозврата, ТекстВывода)

	Части = Новый Массив;
	Части.Добавить("Пользователь ОС: " + ?(ЗначениеЗаполнено(ПользовательОС), ПользовательОС, "не определен"));

	Если ЗначениеЗаполнено(КаталогJavaHome) Тогда
		Части.Добавить("JAVA_HOME: " + КаталогJavaHome);
		Части.Добавить("java.exe в JAVA_HOME: "
			+ ?(ЗначениеЗаполнено(ПутьВJavaHome), ПутьВJavaHome, "не найден"));
	Иначе
		Части.Добавить("JAVA_HOME: не задана");
	КонецЕсли;

	Если ПоискВPath.ПровереноКаталогов = 0 Тогда
		Части.Добавить("PATH: значение не получено");
	Иначе
		Части.Добавить("java.exe в PATH: "
			+ ?(ЗначениеЗаполнено(ПоискВPath.Путь), ПоискВPath.Путь, "не найден")
			+ " (проверено каталогов: " + Строка(ПоискВPath.ПровереноКаталогов) + ")");
	КонецЕсли;

	Части.Добавить("java -version: код возврата " + Строка(КодВозврата));
	Части.Добавить("вывод java -version: " + ВыводВОднуСтроку(ТекстВывода));

	Возврат СтрСоединить(Части, "; ");

КонецФункции

// Приводит многострочный вывод команды к одной строке.
//
// Параметры:
//  ТекстВывода - Строка - вывод команды.
//
// Возвращаемое значение:
//  Строка - вывод в одну строку, обрезанный до 300 символов.
//
Функция ВыводВОднуСтроку(ТекстВывода)

	Вывод = СтрЗаменить(ТекстВывода, Символы.ВК, " ");
	Вывод = СтрЗаменить(Вывод, Символы.ПС, " ");
	Вывод = СтрЗаменить(Вывод, Символы.Таб, " ");
	Вывод = СокрЛП(Вывод);

	Пока СтрНайти(Вывод, "  ") > 0 Цикл
		Вывод = СтрЗаменить(Вывод, "  ", " ");
	КонецЦикла;

	Если СтрДлина(Вывод) > 300 Тогда
		Вывод = Лев(Вывод, 300) + "...";
	КонецЕсли;

	Возврат ?(ЗначениеЗаполнено(Вывод), Вывод, "<пусто>");

КонецФункции

#КонецОбласти
