#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Proverit(Команда)

	РезультатПроверки = ПроверитьНаСервере();

	Если РезультатПроверки.Доступна Тогда
		Сообщить("Джава доступна");
	Иначе
		Сообщить("Джава недоступна");
	КонецЕсли;

	Сообщить("Детали: " + РезультатПроверки.Детали);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выполняет проверку доступности Java в серверном контексте,
// то есть от имени пользователя, под которым работает сервер 1С.
//
// Возвращаемое значение:
//  Структура - результаты проверки (см. JavaCheck.ПроверитьДоступностьДжавы).
//
&НаСервере
Функция ПроверитьНаСервере()

	Возврат РеквизитФормыВЗначение("Объект").ПроверитьДоступностьДжавы();

КонецФункции

#КонецОбласти
